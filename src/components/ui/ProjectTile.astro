---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { ProjectEntry } from "../../lib/content";
import { getDominantColor } from "../../lib/dominant-color";

interface Props {
  project: ProjectEntry;
  href: string;
  ctaLabel: string;
  stackAria: string;
  featured?: boolean;
  eager?: boolean;
  headingLevel?: "h2" | "h3";
}

const {
  project,
  href,
  ctaLabel,
  stackAria,
  featured = false,
  eager = false,
  headingLevel = "h3",
} = Astro.props;

const HeadingTag = headingLevel;
const displayTitle = project.data.cardTitle ?? project.data.title;
const landscape = project.data.imageUrl;
const featuredPortrait = featured ? (project.data.featuredImageUrl ?? null) : null;
const landscapeColor = await getDominantColor(landscape);
const portraitColor = featuredPortrait
  ? await getDominantColor(featuredPortrait)
  : landscapeColor;
const linkLabel = `${ctaLabel}: ${displayTitle}`;
---

<article
  class:list={[
    "card-hover-bordered group/card relative min-w-0 w-full max-w-full overflow-hidden",
    featuredPortrait
      ? "grid grid-cols-1 lg:grid-cols-[16rem_1fr]"
      : "flex h-full min-h-0 flex-col",
  ]}
>
  <a
    href={href}
    class="absolute inset-0 z-10 rounded-[inherit] focus-ring"
    aria-label={linkLabel}
  >
  </a>
  <div
    class:list={[
      "relative min-w-0 overflow-hidden border-b border-border",
      featuredPortrait
        ? "aspect-video lg:aspect-auto lg:flex lg:min-h-80 lg:items-stretch lg:justify-center lg:border-b-0 lg:border-r"
        : "aspect-video",
    ]}
    aria-hidden="true"
  >
    <div
      class:list={["h-full w-full", featuredPortrait && "lg:hidden"]}
      style={`background-color: ${landscapeColor}`}
    >
      <Image
        src={landscape}
        alt=""
        width={landscape.width}
        height={landscape.height}
        sizes={
          featuredPortrait
            ? "(max-width: 1023px) 100vw, 0px"
            : "(max-width: 1024px) 100vw, 40vw"
        }
        class="h-full w-full object-contain"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
    </div>
    {
      featuredPortrait && (
        <div
          class="hidden h-full w-full lg:block"
          style={`background-color: ${portraitColor}`}
        >
          <Image
            src={featuredPortrait}
            alt=""
            width={featuredPortrait.width}
            height={featuredPortrait.height}
            sizes="16rem"
            class="h-full max-h-full w-full object-contain"
            loading={eager ? "eager" : "lazy"}
            decoding="async"
          />
        </div>
      )
    }
  </div>
  <div class="relative flex min-w-0 flex-1 flex-col p-5 md:p-6">
    <HeadingTag class="card-hover-title font-display line-clamp-2 min-w-0 wrap-break-word text-lg font-extrabold leading-snug text-foreground md:text-xl">
      {displayTitle}
    </HeadingTag>
    <p class="mt-3 line-clamp-3 flex-1 text-sm leading-relaxed text-foreground-variant">
      {project.data.shortDescription}
    </p>
    <ul class="mt-4 flex flex-wrap gap-2" aria-label={stackAria}>
      {
        project.data.tech.map((tech) => (
          <li class="rounded-pill bg-muted px-2.5 py-1 text-xs font-semibold text-foreground">
            {tech}
          </li>
        ))
      }
    </ul>
    <p
      class="mt-5 inline-flex min-h-11 items-center justify-center gap-2 self-stretch rounded-pill border border-foreground px-5 py-3 text-sm font-semibold text-foreground transition-colors duration-200 group-hover/card:bg-foreground group-hover/card:text-background"
      aria-hidden="true"
    >
      {ctaLabel}
      <Icon name="arrow" class="size-3.5 shrink-0" />
    </p>
  </div>
</article>
