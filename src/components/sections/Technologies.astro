---
import { Icon } from "astro-icon/components";
import Container from "../ui/Container.astro";
import AccentBar from "../ui/AccentBar.astro";
import Reveal from "../ui/Reveal.astro";
import type { TechnologyList } from "../../lib/content";
import { getPageContext } from "../../lib/i18n/context";

interface Props {
  technologies: TechnologyList;
}

const { ui } = await getPageContext(Astro.currentLocale);
const { technologies } = Astro.props;

const LOCAL_ICONS = new Set(["bullmq", "shadcn", "rest"]);

function resolveIconName(slug: string) {
  return LOCAL_ICONS.has(slug) ? slug : `simple-icons:${slug}`;
}
---

<section
  id="tecnologias"
  class="relative scroll-mt-20 overflow-hidden bg-hero py-16 text-hero-foreground md:py-20 lg:py-24"
  aria-labelledby="tech-heading"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(160deg,var(--color-hero)_0%,var(--color-hero-2)_60%,color-mix(in_srgb,var(--color-accent)_18%,var(--color-hero-2))_160%)]"
    aria-hidden="true"
  ></div>
  <Container class="relative">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-10">
      <Reveal staggerMs={0} class="lg:col-span-5">
        <AccentBar class="mb-6" />
        <h2
          id="tech-heading"
          class="font-display text-3xl font-extrabold leading-tight tracking-tight text-hero-foreground sm:text-4xl md:text-5xl"
        >
          {ui.technologies.title}
        </h2>
        <p class="mt-4 text-sm font-semibold text-hero-foreground/70">
          {ui.technologies.subtitle}
        </p>
      </Reveal>
      <Reveal staggerMs={80} class="flex items-center lg:col-span-7">
        <p class="text-base leading-[1.7] text-hero-foreground/85">
          {ui.technologies.intro}
        </p>
      </Reveal>
    </div>

    <ul
      class="mt-12 divide-y divide-hero-foreground/15 list-none border-y border-hero-foreground/15 lg:mt-14"
    >
      {
        technologies.map((item, index) => (
          <li>
            <Reveal staggerMs={Math.min(index * 30, 180)}>
              <div class="flex flex-col gap-4 py-5 sm:flex-row sm:items-center sm:justify-between sm:gap-8 sm:py-6">
                <div class="min-w-0">
                  <p class="text-xs font-semibold text-hero-foreground/65">
                    {item.role}
                  </p>
                  <h3 class="mt-1 font-display text-lg font-extrabold leading-snug text-hero-foreground md:text-xl">
                    {item.name}
                  </h3>
                </div>
                <ul
                  class="flex shrink-0 list-none flex-wrap gap-2.5"
                  aria-label={`${ui.technologies.iconsAriaPrefix} ${item.name}`}
                >
                  {item.icons.map((slug) => (
                    <li>
                      <span
                        class="tech-logo inline-flex size-9 items-center justify-center rounded-pill bg-hero-foreground/12 text-hero-foreground md:size-10"
                        aria-hidden="true"
                      >
                        <Icon
                          name={resolveIconName(slug)}
                          class="size-4 md:size-5"
                        />
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </Reveal>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style is:global>
  .tech-logo svg {
    max-height: 100%;
    max-width: 100%;
  }

  .tech-logo svg,
  .tech-logo svg :where(path, circle, rect, polygon) {
    fill: currentColor;
  }

  .tech-logo svg :where(line, polyline) {
    stroke: currentColor;
  }
</style>
